module

public import Mathlib.RingTheory.FractionalIdeal.Extended
public import Mathlib.RingTheory.FractionalIdeal.Norm
public import Mathlib.RingTheory.Ideal.Norm.RelNorm
public import DedekindIdealArithmetic.Module.Index

/-!
# Absolute norms and indices of fractional ideals

The absolute norm of the principal fractional ideal generated by an element
of a fractional ideal is the index of its span times the norm of the ideal.
This includes the zero ideal and the zero element, with infinite indices
interpreted as zero.

For a torsion-free extension of Dedekind domains that are finite free over `ℤ`,
extending a fractional ideal raises its absolute norm to the relative rank.
The formula holds for zero as well as nonzero fractional ideals.

The proof clears a denominator using `FractionalIdeal.den_mul_self_eq_num'`,
applies the integral-ideal norm formula, and cancels the norm of a nonzero
integral principal ideal. No freeness over the smaller Dedekind domain is needed.
-/

@[expose] public section

open scoped nonZeroDivisors

namespace FractionalIdeal

section IndexNorm

variable {R : Type*} {K : Type*} [CommRing R] [IsDedekindDomain R]
  [Module.Free ℤ R] [Module.Finite ℤ R]
  [Field K] [Algebra R K] [IsFractionRing R K]

/-- The norm of the principal fractional ideal generated by an element of a
fractional ideal is its span's index times the norm of the fractional ideal.
This holds also for the zero ideal and the zero element. -/
theorem absNorm_spanSingleton_eq_cardQuot_mul (I : FractionalIdeal R⁰ K)
    (x : (I : Submodule R K)) :
    absNorm (spanSingleton R⁰ (x : K)) =
      ((Submodule.span R {x}).cardQuot : ℚ) * absNorm I := by
  let : Infinite R := Module.Free.infinite ℤ R
  let e : (I : Submodule R K) ≃ₗ[R] I.num := equivNum (nonZeroDivisors.coe_ne_zero I.den)
  let f : (I : Submodule R K) →ₗ[R] R := I.num.subtype.comp e.toLinearMap
  have hf : Function.Injective f := I.num.subtype_injective.comp e.injective
  have hfrange : LinearMap.range f = I.num := by
    simp only [f, LinearMap.range_comp, LinearEquiv.range, Submodule.map_top,
      Submodule.range_subtype]
  have hfx : f x = (e x : R) := rfl
  have hindex : (Ideal.span {(e x : R)}).cardQuot =
      (Submodule.span R {x}).cardQuot * I.num.cardQuot := by
    simpa only [← Submodule.span_image, Set.image_singleton, hfrange, hfx] using
      Submodule.cardQuot_map_of_injective f hf (Submodule.span R {x})
  have hx : algebraMap R K (e x : R) =
      algebraMap R K (I.den : R) * (x : K) := by
    simpa only [e, Submonoid.smul_def, Algebra.smul_def] using
      equivNum_apply (nonZeroDivisors.coe_ne_zero I.den) x
  let D : FractionalIdeal R⁰ K := spanSingleton R⁰ (algebraMap R K (I.den : R))
  have hD : absNorm D ≠ 0 := by
    dsimp only [D]
    rw [ne_eq, absNorm_eq_zero_iff, spanSingleton_eq_zero_iff,
      IsFractionRing.to_map_eq_zero_iff]
    exact nonZeroDivisors.coe_ne_zero I.den
  have hspan : D * spanSingleton R⁰ (x : K) =
      (Ideal.span {(e x : R)} : FractionalIdeal R⁰ K) := by
    dsimp only [D]
    rw [spanSingleton_mul_spanSingleton, ← hx, coeIdeal_span_singleton]
  have hnum : D * I = (I.num : FractionalIdeal R⁰ K) :=
    I.den_mul_self_eq_num'
  apply mul_left_cancel₀ hD
  calc
    absNorm D * absNorm (spanSingleton R⁰ (x : K)) =
        absNorm (Ideal.span {(e x : R)} : FractionalIdeal R⁰ K) := by
      rw [← map_mul, hspan]
    _ = ((Submodule.span R {x}).cardQuot : ℚ) *
        absNorm (I.num : FractionalIdeal R⁰ K) := by
      rw [coeIdeal_absNorm, coeIdeal_absNorm, Ideal.absNorm_apply,
        Ideal.absNorm_apply, hindex, Nat.cast_mul]
    _ = ((Submodule.span R {x}).cardQuot : ℚ) * (absNorm D * absNorm I) := by
      rw [← hnum, map_mul]
    _ = absNorm D * (((Submodule.span R {x}).cardQuot : ℚ) * absNorm I) := by
      ac_rfl

end IndexNorm

variable {R S K L : Type*} [CommRing R] [IsDedekindDomain R]
  [CommRing S] [IsDedekindDomain S] [Algebra R S] [Module.IsTorsionFree R S]
  [Module.Free ℤ R] [Module.Finite ℤ R] [Module.Free ℤ S] [Module.Finite ℤ S]
  [Field K] [Field L] [Algebra R K] [Algebra S L]
  [IsFractionRing R K] [IsFractionRing S L]

/-- Extending a fractional ideal along a torsion-free extension of Dedekind domains
that are finite free over `ℤ` raises its absolute norm to the relative rank. -/
theorem absNorm_extendedHom (I : FractionalIdeal R⁰ K) :
    absNorm (extendedHom (A := R) (K := K) L S I) =
      absNorm I ^ Module.finrank R S := by
  have : Module.Finite R S := Module.Finite.of_restrictScalars_finite ℤ R S
  have hcoe (J : Ideal R) :
      absNorm (extendedHom (A := R) (K := K) L S (J : FractionalIdeal R⁰ K)) =
        absNorm (J : FractionalIdeal R⁰ K) ^ Module.finrank R S := by
    rw [extendedHom_coeIdeal_eq_map, coeIdeal_absNorm, coeIdeal_absNorm,
      Ideal.absNorm_algebraMap, Nat.cast_pow]
  let P : Ideal R := Ideal.span {(I.den : R)}
  have hden : (P : FractionalIdeal R⁰ K) * I = (I.num : FractionalIdeal R⁰ K) := by
    simpa only [P, coeIdeal_span_singleton] using I.den_mul_self_eq_num'
  have hP : absNorm (P : FractionalIdeal R⁰ K) ≠ 0 := by
    dsimp only [P]
    rw [ne_eq, absNorm_eq_zero_iff, coeIdeal_span_singleton,
      spanSingleton_eq_zero_iff, IsFractionRing.to_map_eq_zero_iff]
    exact nonZeroDivisors.coe_ne_zero I.den
  apply mul_left_cancel₀ (pow_ne_zero (Module.finrank R S) hP)
  calc
    absNorm (P : FractionalIdeal R⁰ K) ^ Module.finrank R S *
        absNorm (extendedHom (A := R) (K := K) L S I) =
        absNorm (extendedHom (A := R) (K := K) L S
          ((P : FractionalIdeal R⁰ K) * I)) := by
      rw [map_mul, map_mul, hcoe P]
    _ = absNorm (extendedHom (A := R) (K := K) L S
        (I.num : FractionalIdeal R⁰ K)) := by rw [hden]
    _ = absNorm (I.num : FractionalIdeal R⁰ K) ^ Module.finrank R S := hcoe I.num
    _ = (absNorm (P : FractionalIdeal R⁰ K) * absNorm I) ^ Module.finrank R S := by
      rw [← hden, map_mul]
    _ = absNorm (P : FractionalIdeal R⁰ K) ^ Module.finrank R S *
        absNorm I ^ Module.finrank R S := mul_pow _ _ _

end FractionalIdeal
