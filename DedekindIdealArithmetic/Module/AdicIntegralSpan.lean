module

public import Mathlib.RingTheory.DedekindDomain.AdicValuation
public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.TensorProduct.Basic
public import Mathlib.RingTheory.TensorProduct.Finite

/-!
# Integral spans in adic module fibres

For a height-one prime `p` of a Dedekind domain `R`, write `F` for
`p.adicCompletion K` and `O` for its valuation-integer ring
`p.adicCompletionIntegers K`. The integral span of an `R`-module `M` is the
`O`-submodule of `F ⊗[R] M` generated by the sections `1 ⊗ₜ m`.

The canonical map `O ⊗[R] M →ₗ[O] F ⊗[R] M` has this span as its range.
For a flat module it is injective, giving an equivalence onto the integral
span. If `M` is finite over `R`, the integral span is finite over `O`.
Its span over `F` is the whole fibre. For the scalar module `R`, the tensor
right-unit equivalence identifies the integral span exactly with `O`.

These constructions use Mathlib's valuation-integer rings, scalar-extension
maps, and flat-module API. All tensor products in this file are algebraic.
-/

@[expose] public section

open scoped TensorProduct
open IsDedekindDomain

universe u v w

namespace Module

variable {R : Type u} [CommRing R] [IsDedekindDomain R]
variable {K : Type v} [Field K] [Algebra R K] [IsFractionRing R K]
variable (M : Type w) [AddCommGroup M] [Module R M]
variable (p : HeightOneSpectrum R)

local notation "F" => p.adicCompletion K
local notation "O" => p.adicCompletionIntegers K

/-- The span over the adic valuation-integer ring of the sections of `M` in
its adic fibre. -/
noncomputable def adicIntegralSpan : Submodule O (F ⊗[R] M) :=
  Submodule.span O (Set.range (TensorProduct.mk R F M 1))

/-- Every section belongs to the integral span. -/
@[simp]
theorem one_tmul_mem_adicIntegralSpan (m : M) :
    (1 : F) ⊗ₜ[R] m ∈ adicIntegralSpan (K := K) M p :=
  Submodule.subset_span ⟨m, rfl⟩

/-- To contain the integral span, it suffices to contain every section. -/
theorem adicIntegralSpan_le_iff (S : Submodule O (F ⊗[R] M)) :
    adicIntegralSpan (K := K) M p ≤ S ↔ ∀ m : M, (1 : F) ⊗ₜ[R] m ∈ S := by
  change Submodule.span O _ ≤ S ↔ _
  rw [Submodule.span_le]
  constructor
  · intro h m
    exact h ⟨m, rfl⟩
  · rintro h _ ⟨m, rfl⟩
    exact h m

/-- The scalar-extension map induced by the inclusion of valuation
integers into the adic field. -/
noncomputable def adicIntegralSpanMap : O ⊗[R] M →ₗ[O] F ⊗[R] M :=
  (TensorProduct.mk R F M 1).liftBaseChange O

/-- On pure tensors, the integral-span map is induced by the inclusion of
valuation integers into the adic field. -/
@[simp]
theorem adicIntegralSpanMap_tmul (o : O) (m : M) :
    adicIntegralSpanMap (K := K) M p (o ⊗ₜ[R] m) = (o : F) ⊗ₜ[R] m := by
  simp only [adicIntegralSpanMap, LinearMap.liftBaseChange_tmul, TensorProduct.mk_apply,
    TensorProduct.smul_tmul', Algebra.smul_def, ValuationSubring.algebraMap_apply, mul_one]

/-- The range of the scalar-extension map is the integral span. -/
@[simp]
theorem range_adicIntegralSpanMap :
    LinearMap.range (adicIntegralSpanMap (K := K) M p) =
      adicIntegralSpan (K := K) M p := by
  simpa only [adicIntegralSpanMap, adicIntegralSpan, LinearMap.coe_range] using
    (LinearMap.range_liftBaseChange O (TensorProduct.mk R F M 1))

/-- For a finite module, the integral span is finite over the adic
valuation-integer ring. -/
instance instFiniteAdicIntegralSpan [Module.Finite R M] :
    Module.Finite O (adicIntegralSpan (K := K) M p) := by
  rw [← range_adicIntegralSpanMap (K := K) M p]
  infer_instance

/-- Extending scalars from the integral span to the adic field spans the
whole fibre. -/
theorem span_adicIntegralSpan_eq_top :
    Submodule.span F (adicIntegralSpan (K := K) M p : Set (F ⊗[R] M)) = ⊤ := by
  rw [adicIntegralSpan, Submodule.span_span_of_tower]
  simpa only [Submodule.baseChange_top, Submodule.map_top, LinearMap.coe_range] using
    (Submodule.baseChange_eq_span F (⊤ : Submodule R M)).symm

/-- Scalar extension from the adic valuation-integer ring into the adic
field is injective when `M` is flat over `R`. -/
theorem adicIntegralSpanMap_injective [Module.Flat R M] :
    Function.Injective (adicIntegralSpanMap (K := K) M p) := by
  have hmap :
      (adicIntegralSpanMap (K := K) M p).restrictScalars R =
        ((Algebra.linearMap O F).restrictScalars R).rTensor M := by
    apply TensorProduct.ext'
    intro o m
    simp only [LinearMap.restrictScalars_apply, adicIntegralSpanMap_tmul,
      LinearMap.rTensor_tmul, Algebra.linearMap_apply, ValuationSubring.algebraMap_apply]
  change Function.Injective ((adicIntegralSpanMap (K := K) M p).restrictScalars R)
  rw [hmap]
  exact Module.Flat.rTensor_preserves_injective_linearMap _ Subtype.val_injective

/-- For a flat module, scalar extension to the adic valuation-integer ring
is linearly equivalent to its integral span in the adic fibre. -/
noncomputable def adicIntegralSpanEquiv [Module.Flat R M] :
    O ⊗[R] M ≃ₗ[O] adicIntegralSpan (K := K) M p :=
  LinearEquiv.ofInjective (adicIntegralSpanMap (K := K) M p)
      (adicIntegralSpanMap_injective (K := K) M p) ≪≫ₗ
    LinearEquiv.ofEq _ _ (range_adicIntegralSpanMap (K := K) M p)

/-- The integral-span equivalence has the canonical scalar-extension map
as its underlying map into the fibre. -/
@[simp]
theorem adicIntegralSpanEquiv_apply [Module.Flat R M] (x : O ⊗[R] M) :
    (adicIntegralSpanEquiv (K := K) M p x : F ⊗[R] M) =
      adicIntegralSpanMap (K := K) M p x := by
  simp only [adicIntegralSpanEquiv, LinearEquiv.trans_apply, LinearEquiv.coe_ofEq_apply,
    LinearEquiv.ofInjective_apply]

/-- On the whole scalar fibre, membership in the integral span is exactly
membership in the valuation-integer ring under the tensor right-unit equivalence. -/
@[simp]
theorem mem_adicIntegralSpan_self_iff (x : F ⊗[R] R) :
    x ∈ adicIntegralSpan (K := K) R p ↔
      TensorProduct.AlgebraTensorModule.rid R F F x ∈ O := by
  rw [← range_adicIntegralSpanMap (K := K) R p]
  constructor
  · rintro ⟨y, rfl⟩
    induction y using TensorProduct.inductionOn with
    | tmul o r =>
      rw [adicIntegralSpanMap_tmul, TensorProduct.AlgebraTensorModule.rid_tmul,
        Algebra.smul_def, IsScalarTower.algebraMap_apply R O F]
      exact mul_mem (algebraMap R O r).property o.property
    | add y z hy hz =>
      simpa only [map_add] using add_mem hy hz
  · intro hx
    refine ⟨(⟨TensorProduct.AlgebraTensorModule.rid R F F x, hx⟩ : O) ⊗ₜ[R] (1 : R), ?_⟩
    rw [adicIntegralSpanMap_tmul]
    simpa only [TensorProduct.AlgebraTensorModule.rid_symm_apply] using
      (TensorProduct.AlgebraTensorModule.rid R F F).symm_apply_apply x

end Module
