module

public import Mathlib.Algebra.Module.Torsion.Free
public import Mathlib.LinearAlgebra.TensorProduct.Tower
public import Mathlib.RingTheory.Finiteness.Basic
public import Mathlib.RingTheory.FractionalIdeal.Operations
public import Mathlib.RingTheory.Localization.BaseChange

/-!
# Coefficient ideals of modules in a rational frame

A linear equivalence `e : K ⊗[R] M ≃ₗ[K] K` gives an `R`-linear coefficient
map on `M` by sending `m` to `e (1 ⊗ₜ m)`. If `M` is finite and `K` is a
fraction field of `R`, its image is a fractional ideal. This construction
uses the given module, without an injectivity or freeness assumption on it.

The coefficient ideal is nonzero because the tensors `1 ⊗ₜ m` span the
rational fibre over `K`. Over a fraction field, the coefficient map of a
torsion-free module is injective, without any finiteness assumption. When the
module is also finite,
`LinearEquiv.ofInjective e.coefficientMap e.coefficientMap_injective` identifies
it with `e.coefficientIdeal`, whose underlying submodule is definitionally the
range. The coercion and inverse formulas are `LinearEquiv.ofInjective_apply`
and `LinearEquiv.ofInjective_symm_apply`.

For the scalar module `R` with its multiplication frame, the coefficient map
is the algebra map and its ideal is the unit fractional ideal.

Changing from a frame `e` to a frame `e'` multiplies the coefficient map by
`e' (e.symm 1)` and the coefficient ideal by the principal fractional ideal
generated by this scalar. The scalar is nonzero because both frames are
linear equivalences.

The frame is auxiliary data for this construction; no frame-independent
arithmetic invariant is defined here.
-/

@[expose] public section

open scoped TensorProduct nonZeroDivisors

namespace LinearEquiv

universe u v w

variable {R : Type u} {K : Type v} {M : Type w}
variable [CommRing R] [Field K] [Algebra R K] [AddCommGroup M] [Module R M]
variable (e : K ⊗[R] M ≃ₗ[K] K)

/-- The coefficient map of a module in a rational frame. -/
def coefficientMap : M →ₗ[R] K :=
  (e.toLinearMap.restrictScalars R).comp (TensorProduct.mk R K M 1)

@[simp]
theorem coefficientMap_apply (m : M) :
    e.coefficientMap m = e (1 ⊗ₜ[R] m) :=
  rfl

/-- Changing rational frames multiplies the coefficient map by the coefficient
of the old unit vector in the new frame. -/
theorem coefficientMap_eq_smul (e' : K ⊗[R] M ≃ₗ[K] K) :
    e'.coefficientMap = e' (e.symm 1) • e.coefficientMap := by
  ext m
  simp only [LinearMap.smul_apply, coefficientMap_apply, smul_eq_mul]
  calc
    e' (1 ⊗ₜ[R] m) = e' (e.symm (e (1 ⊗ₜ[R] m))) := by
      rw [symm_apply_apply]
    _ = e' (e (1 ⊗ₜ[R] m) • e.symm 1) := by
      rw [← e.symm.map_smul, smul_eq_mul, mul_one]
    _ = e' (e.symm 1) * e (1 ⊗ₜ[R] m) := by
      rw [e'.map_smul, smul_eq_mul, mul_comm]

/-- A rational frame embeds a torsion-free module into its fraction field.
No finiteness assumption on the module is needed. -/
theorem coefficientMap_injective [IsFractionRing R K] [Module.IsTorsionFree R M] :
    Function.Injective e.coefficientMap := by
  have h : Function.Injective (TensorProduct.mk R K M 1) := by
    apply (IsLocalizedModule.injective_iff_isRegular R⁰
      (TensorProduct.mk R K M 1)).mpr
    intro c
    exact (isRegular_iff_mem_nonZeroDivisors.mpr c.property).isSMulRegular
  exact e.injective.comp h

/-- In the multiplication frame of the scalar module, coefficients are
images under the algebra map. -/
theorem coefficientMap_rid (r : R) :
    (TensorProduct.AlgebraTensorModule.rid R K K).coefficientMap r = algebraMap R K r := by
  simp only [coefficientMap_apply, TensorProduct.AlgebraTensorModule.rid_tmul,
    Algebra.smul_def, mul_one]

section FractionField

variable [IsFractionRing R K] [Module.Finite R M]

/-- The fractional ideal of coefficients of integral sections in a rational
frame. Its underlying submodule is the range of the coefficient map. -/
def coefficientIdeal : FractionalIdeal R⁰ K :=
  ⟨LinearMap.range e.coefficientMap,
    FractionalIdeal.isFractional_of_fg (Submodule.fg_range e.coefficientMap)⟩

@[simp]
theorem coe_coefficientIdeal :
    (e.coefficientIdeal : Submodule R K) = LinearMap.range e.coefficientMap :=
  rfl

/-- An element belongs to the coefficient ideal exactly when it is the
coefficient of a section of the given module. -/
theorem mem_coefficientIdeal_iff {a : K} :
    a ∈ e.coefficientIdeal ↔ ∃ m : M, e (1 ⊗ₜ[R] m) = a :=
  Iff.rfl

/-- The coefficient of every integral section belongs to the coefficient ideal. -/
theorem apply_one_tmul_mem_coefficientIdeal (m : M) :
    e (1 ⊗ₜ[R] m) ∈ e.coefficientIdeal :=
  (e.mem_coefficientIdeal_iff).mpr ⟨m, rfl⟩

/-- Changing rational frames multiplies the coefficient ideal by the principal
fractional ideal generated by the coefficient of the old unit vector in the new frame. -/
theorem coefficientIdeal_eq_spanSingleton_mul (e' : K ⊗[R] M ≃ₗ[K] K) :
    e'.coefficientIdeal =
      FractionalIdeal.spanSingleton R⁰ (e' (e.symm 1)) * e.coefficientIdeal := by
  have h (m : M) :
      e' (1 ⊗ₜ[R] m) = e' (e.symm 1) * e (1 ⊗ₜ[R] m) := by
    simpa only [LinearMap.smul_apply, coefficientMap_apply, smul_eq_mul] using
      congrArg (fun f : M →ₗ[R] K => f m) (e.coefficientMap_eq_smul e')
  apply FractionalIdeal.ext
  intro a
  rw [mem_coefficientIdeal_iff, FractionalIdeal.mem_singleton_mul]
  constructor
  · rintro ⟨m, rfl⟩
    exact ⟨e (1 ⊗ₜ[R] m), e.apply_one_tmul_mem_coefficientIdeal m, h m⟩
  · rintro ⟨b, hb, rfl⟩
    obtain ⟨m, rfl⟩ := e.mem_coefficientIdeal_iff.mp hb
    exact ⟨m, h m⟩

/-- A rational frame forces its coefficient ideal to be nonzero, even without
assuming that the map from the module to its rational fibre is injective. -/
theorem coefficientIdeal_ne_zero : e.coefficientIdeal ≠ 0 := by
  intro hI
  have hm (m : M) : e (1 ⊗ₜ[R] m) = 0 := by
    have hmem := e.apply_one_tmul_mem_coefficientIdeal m
    rw [hI] at hmem
    exact (FractionalIdeal.mem_zero_iff R⁰).mp hmem
  have hz (x : K ⊗[R] M) : e x = 0 := by
    induction x using TensorProduct.inductionOn with
    | tmul a m =>
        rw [TensorProduct.tmul_eq_smul_one_tmul, map_smul, hm, smul_zero]
    | add x y hx hy => rw [map_add, hx, hy, add_zero]
  exact one_ne_zero (by simpa only [apply_symm_apply] using hz (e.symm 1))

end FractionField

/-- The coefficient ideal of the scalar module in its multiplication frame
is the unit fractional ideal. -/
@[simp]
theorem coefficientIdeal_rid [IsFractionRing R K] :
    (TensorProduct.AlgebraTensorModule.rid R K K).coefficientIdeal =
      (1 : FractionalIdeal R⁰ K) := by
  apply FractionalIdeal.ext
  intro a
  rw [mem_coefficientIdeal_iff, FractionalIdeal.mem_one_iff]
  simp only [TensorProduct.AlgebraTensorModule.rid_tmul, Algebra.smul_def, mul_one]

/-- For the scalar multiplication frame, the inverse of the equivalence
onto the coefficient ideal recovers the scalar represented by a coefficient. -/
@[simp]
theorem algebraMap_ofInjective_coefficientMap_rid_symm_apply [IsFractionRing R K]
    (a : (TensorProduct.AlgebraTensorModule.rid R K K).coefficientIdeal) :
    algebraMap R K ((LinearEquiv.ofInjective
      (TensorProduct.AlgebraTensorModule.rid R K K).coefficientMap
      (TensorProduct.AlgebraTensorModule.rid R K K).coefficientMap_injective).symm a) =
        (a : K) := by
  simpa only [coefficientMap_rid] using
    (LinearEquiv.ofInjective_symm_apply
      (f := (TensorProduct.AlgebraTensorModule.rid R K K).coefficientMap)
      (h := (TensorProduct.AlgebraTensorModule.rid R K K).coefficientMap_injective) a)

end LinearEquiv
