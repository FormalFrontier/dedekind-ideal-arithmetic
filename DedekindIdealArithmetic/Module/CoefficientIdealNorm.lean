module

public import DedekindIdealArithmetic.Ideal.FractionalNorm
public import DedekindIdealArithmetic.Module.CoefficientIdeal

/-!
# Norms and indices in a rational frame

For a finite torsion-free module over a Dedekind domain finite free over `ℤ`,
a rational frame identifies the module with its coefficient fractional ideal.
The index of the span of a section, multiplied by the norm of this ideal,
is the norm of the principal fractional ideal generated by its coefficient.
The formula holds for every section, including zero.
-/

@[expose] public section

open scoped TensorProduct nonZeroDivisors

namespace LinearEquiv

universe u v w

variable {R : Type u} {K : Type v} {M : Type w}
variable [CommRing R] [IsDedekindDomain R] [Module.Free ℤ R] [Module.Finite ℤ R]
variable [Field K] [Algebra R K] [IsFractionRing R K]
variable [AddCommGroup M] [Module R M] [Module.Finite R M] [Module.IsTorsionFree R M]

/-- The index of the span of a section times the norm of the coefficient ideal
is the norm of the principal fractional ideal generated by its coefficient. -/
theorem cardQuot_span_singleton_mul_absNorm_coefficientIdeal
    (e : K ⊗[R] M ≃ₗ[K] K) (m : M) :
    ((Submodule.span R {m}).cardQuot : ℚ) * FractionalIdeal.absNorm e.coefficientIdeal =
      FractionalIdeal.absNorm (FractionalIdeal.spanSingleton R⁰ (e.coefficientMap m)) := by
  let f : M ≃ₗ[R] (e.coefficientIdeal : Submodule R K) :=
    LinearEquiv.ofInjective e.coefficientMap e.coefficientMap_injective
  have hindex : (Submodule.span R {f m}).cardQuot =
      (Submodule.span R {m}).cardQuot := by
    simpa only [← Submodule.span_image, Set.image_singleton, LinearEquiv.coe_toLinearMap,
      LinearEquiv.range, Submodule.cardQuot_top, mul_one] using
      Submodule.cardQuot_map_of_injective f.toLinearMap f.injective (Submodule.span R {m})
  have hfm : (f m : K) = e.coefficientMap m :=
    LinearEquiv.ofInjective_apply e.coefficientMap m
  have h := FractionalIdeal.absNorm_spanSingleton_eq_cardQuot_mul e.coefficientIdeal (f m)
  rw [hindex, hfm] at h
  exact h.symm

end LinearEquiv
